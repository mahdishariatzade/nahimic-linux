[Unit]
Description=Nahimic speaker effects
Wants=pipewire.service pipewire-pulse.service wireplumber.service
After=pipewire.service pipewire-pulse.service wireplumber.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/nahimic --service
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=30
UMask=0077
Nice=-11
LimitRTPRIO=95
LimitMEMLOCK=infinity

[Install]
WantedBy=default.target
